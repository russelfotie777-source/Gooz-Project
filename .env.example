# Copy to `.env` at the repo root (gitignored) to fill in docker-compose.yml's
# ${...} placeholders. Not read anywhere outside of `docker compose` — each
# app still has its own .env for local (non-Docker) development.

APP_ENV=local
# Generate with: php artisan key:generate --show (run once inside the
# backend container or locally with php84) — required, Laravel won't boot
# without it.
APP_KEY=

DB_DATABASE=gooz
DB_USERNAME=gooz
DB_PASSWORD=gooz
DB_ROOT_PASSWORD=root

BACKEND_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_PUBLIC_API_URL=http://localhost:8001/api/v1
ADMIN_PUBLIC_API_URL=http://localhost:8001/api/v1

# Optional — leave every line below unset for local dev (uploads stay on
# local disk, exactly like without Docker). Set these for a production
# stack: MEDIA_DISK=s3, plus credentials for the bucket (R2, S3, or any
# other S3-compatible host — see backend/.env.example for the full
# explanation of each key).
# MEDIA_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=true
