# URL de l'API backend Laravel (avec le préfixe /api/v1), utilisée par le
# navigateur — doit donc être joignable depuis l'appareil qui teste le site
# (un tunnel devtunnels/ngrok en plus de localhost, pour tester sur
# téléphone par exemple).
# En local avec `php artisan serve` : http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optionnel — URL que le serveur Next.js (rendu côté serveur) utilise pour
# appeler le backend, séparée de NEXT_PUBLIC_API_URL ci-dessus pour que le
# rendu serveur continue de parler directement au backend (rapide, fiable)
# même quand NEXT_PUBLIC_API_URL pointe vers un tunnel public pour les
# besoins du navigateur. Par défaut : http://127.0.0.1:8001/api/v1
# INTERNAL_API_URL=http://127.0.0.1:8001/api/v1
